{
  "name": "apk-diff-tool",
  "productName": "APK Diff Tool",
  "version": "1.4.0",
  "description": "Desktop tool that decompiles two APK files with apktool and visually compares permissions, AndroidManifest metadata, smali code and resource files.",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "author": "APK Diff Tool",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "adm-zip": "^0.5.14",
    "diff": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xmldoc": "^1.3.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^5.2.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8",
    "electron": "31.7.7",
    "electron-builder": "^24",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vite": "^5",
    "wait-on": "^7"
  }
}
